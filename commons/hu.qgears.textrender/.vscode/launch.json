{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug myapp",
            "type": "cppdbg",
            "request": "launch",

            "program": "${workspaceFolder}/src/main/resources/hu/qgears/textrender/stbtt/libqstbtruetype-ubuntu-24.04-x86_64.so.exe",
            "cwd": "${workspaceFolder}/src/main/native/stbtt",

            "stopAtEntry": true,
            "externalConsole": true,

            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",

            "preLaunchTask": "make myapp",

            "args": [],

            "sourceFileMap": {
                "..": "${workspaceFolder}/src/main/native/stbtt"
            }
        },
        {
            "name": "Debug libschrift bversion",
            "type": "cppdbg",
            "request": "launch",

            "program": "${workspaceFolder}/src/main/resources/hu/qgears/textrender/libschrift/libqlibschrift-ubuntu-24.04-x86_64.so.exe",
            "cwd": "${workspaceFolder}/src/main/native/libschrift",

            "stopAtEntry": true,
            "externalConsole": false,

            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",

            "preLaunchTask": "make libschrift bversion",

            "args": [],

            "sourceFileMap": {
                "..": "${workspaceFolder}/src/main/native/libschrift",            }
        },
    ]
}
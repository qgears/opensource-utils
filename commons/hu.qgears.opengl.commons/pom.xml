<?xml version="1.0" encoding="UTF-8" standalone="no"?><project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>hu.qgears</groupId>
		<artifactId>hu.qgears.opengl.commons.base</artifactId>
		<version>12.5.2-SNAPSHOT</version>
		<relativePath>pom-base</relativePath>
	</parent>

	<artifactId>hu.qgears.opengl.commons</artifactId>
	<packaging>jar</packaging>
	<description>OpenGL helper methods and object oriented abstraction layer over OpenGL API.</description>

	<properties>
		<lwjglSrcDir>src/main/${lwjglMode}</lwjglSrcDir>
	</properties>

	<profiles>
		<profile>
			<!-- org.lwjgl.* packages aren't p2-visible (plain Maven deps, not OSGi bundles in our target platform) -->
			<id>regenmanifest</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.felix</groupId>
						<artifactId>maven-bundle-plugin</artifactId>
						<executions>
							<execution>
								<id>gen-manifest</id>
								<configuration>
									<instructions>
										<Import-Package>!org.lwjgl,!org.lwjgl.glfw,!org.lwjgl.opengl,!org.lwjgl.openal,!org.lwjgl.stb,!org.lwjgl.assimp,!org.lwjgl.system,!org.lwjgl.util,!org.lwjgl.util.glu,!org.lwjgl.util.vector,!lwjgl.standalone,*</Import-Package>
									</instructions>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
		<!-- This profile should be activated only for eclipse : make possible to develop lwjgl2 mode
		 To activate : Eclipse project Properties -> Maven -> Activate Maven Profiles : "lwjgl2mode,!lwjgl3mode"
		
		-->
			<id>lwjgl2mode</id>
			<activation>
				<property>
					<name>lwjgl2mode</name>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>hu.qgears</groupId>
					<artifactId>lwjgl.fork</artifactId>
				</dependency>
			</dependencies>
			<properties>
				<lwjglMode>lwjgl2</lwjglMode>
			</properties>
		</profile>
		<profile>
			<id>lwjgl3mode</id>
			<activation>
				<property>
					<name>!lwjgl2mode</name>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>hu.qgears</groupId>
					<artifactId>lwjgl3.int</artifactId>
				</dependency>
			</dependencies>
			<properties>
				<lwjglMode>lwjgl3</lwjglMode>
			</properties>
		</profile>
	</profiles>
</project>
